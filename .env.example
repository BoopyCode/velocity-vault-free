# Velocity Vault - FREE AI YouTube Shorts Automation
# Copy this file to .env and fill in your credentials

# DeepSeek API (Get FREE at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk_your_deepseek_key_here

# Replicate (Get FREE at https://replicate.com - 1000 monthly credits)
REPLICATE_API_TOKEN=your_replicate_token_here

# YouTube OAuth2 (Setup at https://console.cloud.google.com)
YOUTUBE_OAUTH_TOKEN=your_youtube_oauth_token
YOUTUBE_CHANNEL_ID=UCp3eKZhxDGwruAdId9pxgcg

# Piper TTS (Local - no API key needed)
PIPER_VOICE=en_US-ryan-medium
PIPER_SPEAKER_ID=0

# Output Settings
OUTPUT_DIR=./videos
LOG_LEVEL=INFO
VIDEO_QUALITY=720p
FRAME_RATE=30

# Batch Settings
BATCH_SIZE=10
VIDEOS_PER_DAY=3
SCHEDULE_UPLOAD=true
UPLOAD_TIME=09:00  # UTC
