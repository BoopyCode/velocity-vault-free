# Mobile Vault - AI marketplace listing assistant
# Copy this file to .env and fill in your credentials

# OpenAI-compatible AI provider
MARKETPLACE_AI_API_KEY=your_ai_api_key_here
MARKETPLACE_AI_BASE_URL=https://api.deepseek.com/v1
MARKETPLACE_AI_MODEL=deepseek-chat

# Backward-compatible fallback if MARKETPLACE_AI_API_KEY is not set
DEEPSEEK_API_KEY=sk_your_deepseek_key_here

# Listing settings
LISTING_LANGUAGE=sk
LISTING_CURRENCY=EUR
OUTPUT_DIR=./listings
LOG_LEVEL=INFO
